// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
  DELETED
  SUSPENDED
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  DELETED
}

enum UserRole {
  ADMIN
  USER
  MANAGER
  MODERATOR
  SUPPORT
  CEO
}

enum Provider {
  LOCAL
  GOOGLE
  GITHUB
  DISCORD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PlanName {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum Language {
  EN
  PT
  ES
  FR
  DE
  IT
  JA
  KO
  ZH
  AR
  HI
  BN
}

enum Timezone {
  UTC
  GMT
  CET
  EST
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum AiMode {
  GENERATIVE
  STREAMING
}

enum IntegrationProvider {
  GOOGLE
  GITHUB
  DISCORD
  NOTION
  SLACK
  GMAIL
  WORD
  EXCEL
  SPOTIFY
  FIGMA
  CANVA
  TELEGRAM
  GAMMA
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum AuditLogAction {
  LOGIN
  LOGOUT
  REGISTER
  RESET_PASSWORD
}

enum AuditLogStatus {
  SUCCESS
  FAILED
  CANCELLED
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationType {
  EMAIL
  IN_APP
  SMS
}

enum NotificationStatus {
  PENDING
  READ
  UNREAD
}

enum UploadType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
}

enum UploadStatus {
  UPLOADING
  COMPLETED
  FAILED
  DELETED
  CANCELLED
}

enum PaymentGateway {
  ASAAS
  STRIPE
  MERCADO_PAGO
  PAYPAL
}

model User {
  id               String     @id @default(uuid())
  name             String
  username         String     @unique
  email            String     @unique
  passwordHash     String     @map("password_hash")
  phone            String?
  avatar           String?
  provider         Provider   @default(LOCAL) @map("provider")
  roleId           String     @map("role_id")
  emailVerified    Boolean    @default(false) @map("email_verified")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  status           UserStatus @default(PENDING)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  role                Role                 @relation(fields: [roleId], references: [id])
  profile             Profile?
  userSettings        UserSettings?
  affiliate           Affiliate?           @relation("AffiliateUser")
  approvedAffiliates  Affiliate[]          @relation("AffiliateApprovedBy")
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  bansReceived        Ban[]                @relation("UserBans")
  bansIssued          Ban[]                @relation("BannedBy")
  warningsReceived    Warning[]            @relation("UserWarnings")
  warningsIssued      Warning[]            @relation("WarnedBy")
  subscriptions       Subscription[]
  payments            Payment[]
  invoices            Invoice[]
  couponRedemptions   CouponRedemption[]
  conversations       Conversation[]
  aiMemory            AiMemory[]
  aiContext           AiContext[]
  tasks               Task[]
  taskLists           TaskList[]
  calendarEvents      CalendarEvent[]
  automations         Automation[]
  integrations        Integration[]
  notifications       Notification[]
  devices             Device[]
  apiKeys             ApiKey[]
  uploads             Upload[]
  ownedOrganizations  Organization[]       @relation("OrgOwner")
  organizationMembers OrganizationMember[]
  auditLogs           AuditLog[]
  emails              Email[]
  supportTickets      SupportTicket[]

  @@map("users")
}

model Profile {
  id       String   @id @default(uuid())
  userId   String   @unique @map("user_id")
  bio      String?
  language Language @default(EN)
  timezone Timezone
  theme    Theme    @default(SYSTEM)
  voice    String?
  aiName   String?  @map("ai_name")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Affiliate {
  id                   String          @id @default(cuid())
  userId               String          @unique
  couponId             String
  approvedBy           String?
  commissionPercentage Decimal         @db.Decimal(5, 2)
  freePlan             PlanName        @default(PRO)
  status               AffiliateStatus @default(PENDING)
  approvedAt           DateTime?
  createdAt            DateTime        @default(now())
  user                 User            @relation("AffiliateUser", fields: [userId], references: [id], onDelete: Cascade)
  coupon               Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  approvedByUser       User?           @relation("AffiliateApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@map("affiliates")
}

model Role {
  id          String       @id @default(uuid())
  name        UserRole     @unique
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  roleId String @map("role_id")
  name   String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  token            String   @unique
  deviceName       String?  @map("device_name")
  deviceType       String?  @map("device_type")
  operatingSystem  String?  @map("operating_system")
  browser          String?
  browserVersion   String?  @map("browser_version")
  ipAddress        String?  @map("ip_address")
  country          String?
  state            String?
  city             String?
  timezone         Timezone
  userAgent        String?  @map("user_agent")
  isCurrentSession Boolean  @default(false) @map("is_current_session")
  isActive         Boolean  @default(true) @map("is_active")
  isTrusted        Boolean  @default(false) @map("is_trusted")
  loginMethod      String   @map("login_method")
  lastActivity     DateTime @default(now()) @map("last_activity")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Ban {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  reason    String
  type      String
  expiresAt DateTime? @map("expires_at")
  bannedBy  String    @map("banned_by")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user   User @relation("UserBans", fields: [userId], references: [id], onDelete: Cascade)
  banner User @relation("BannedBy", fields: [bannedBy], references: [id])

  @@map("bans")
}

model Warning {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  reason      String
  description String?
  warnedBy    String    @map("warned_by")
  status      String
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  warner User @relation("WarnedBy", fields: [warnedBy], references: [id])

  @@map("warnings")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserSettings {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  theme         Theme    @default(SYSTEM)
  language      Language @default(EN)
  timezone      Timezone
  notifications Boolean  @default(true)
  voice         String?
  aiMode        AiMode   @default(GENERATIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Plan {
  id String @id @default(uuid())
  name PlanName @default(FREE)
  price Decimal @db.Decimal(10,2)
  dailyRequests Int @map("daily_requests")
  storageLimit Int @map("storage_limit")
  maxConversations Int? @map("max_conversations")
  maxAssistants Int? @map("max_assistants")
  maxUploads Int? @map("max_uploads")
  maxImages Int? @map("max_images")
  maxAudioMinutes Int? @map("max_audio_minutes")
  prioritySupport Boolean @default(false) @map("priority_support")
  teamMembers Int? @map("team_members")
  apiAccess Boolean @default(false) @map("api_access")
  customBranding Boolean @default(false) @map("custom_branding")
  voiceEnabled Boolean @default(false) @map("voice_enabled")
  maxTokensPerDay Int? @map("max_tokens_per_day")
  maxStoragePerFile Int @map("max_storage_per_file")
  createdAt DateTime @default(now()) @map("created_at")
  subscriptions Subscription[]
  coupons Coupon[]
  accessCodes AccessCode[]
  @@map("plans")
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  planId      String             @map("plan_id")
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now()) @map("started_at")
  expiresAt   DateTime           @map("expires_at")
  renewalDate DateTime           @map("renewal_date")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  subscriptionId String         @map("subscription_id")
  gateway        PaymentGateway @default(ASAAS)
  amount         Decimal        @db.Decimal(10, 2)
  currency       String         @default("USD")
  status         PaymentStatus  @default(PENDING)
  paidAt         DateTime?      @map("paid_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User               @relation(fields: [userId], references: [id])
  subscription Subscription       @relation(fields: [subscriptionId], references: [id])
  invoices     Invoice[]
  redemptions  CouponRedemption[]

  @@map("payments")
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  paymentId String   @map("payment_id")
  amount    Decimal  @db.Decimal(10, 2)
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("invoices")
}

model Coupon {
  id        String       @id @default(uuid())
  code      String       @unique
  type      CouponType   @default(PERCENTAGE)
  value     Decimal      @db.Decimal(10, 2)
  maxUses   Int          @map("max_uses")
  usedCount Int          @default(0) @map("used_count")
  status    CouponStatus @default(ACTIVE)
  planId    String?      @map("plan_id")
  expiresAt DateTime?    @map("expires_at")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")

  plan        Plan?              @relation(fields: [planId], references: [id])
  redemptions CouponRedemption[]
  affiliates  Affiliate[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  userId         String   @map("user_id")
  paymentId      String   @map("payment_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("coupon_redemptions")
}

model AccessCode {
  id        String    @id @default(uuid())
  code      String    @unique
  planId    String    @map("plan_id")
  expiresAt DateTime? @map("expires_at")
  maxUses   Int       @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@map("access_codes")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  model     String
  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @db.Text
  tokens         Int?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  uploadId  String @map("upload_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  upload  Upload  @relation(fields: [uploadId], references: [id])

  @@map("message_attachments")
}

model AiMemory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_memory")
}

model AiContext {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  context   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_context")
}

model Task {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  taskListId  String?      @map("task_list_id")
  title       String
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?    @map("due_date")
  completedAt DateTime?    @map("completed_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskList TaskList?   @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  labels   TaskLabel[]

  @@map("tasks")
}

model TaskList {
  id     String @id @default(uuid())
  userId String @map("user_id")
  name   String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@map("task_lists")
}

model TaskLabel {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  label  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_labels")
}

model CalendarEvent {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  title       String
  description String?    @db.Text
  start       DateTime
  end         DateTime
  location    String?
  reminder    Boolean    @default(false)
  status      TaskStatus @default(PENDING)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@map("calendar_events")
}

model Reminder {
  id            String  @id @default(uuid())
  eventId       String  @map("event_id")
  minutesBefore Int     @map("minutes_before")
  sent          Boolean @default(false)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Automation {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  name    String
  trigger String
  action  String
  enabled Boolean @default(true)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs AutomationLog[]

  @@map("automations")
}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String   @map("automation_id")
  status       String
  response     String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("automation_logs")
}

model Integration {
  id       String              @id @default(uuid())
  userId   String              @map("user_id")
  provider IntegrationProvider
  status   String

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  token IntegrationToken?

  @@map("integrations")
}

model IntegrationToken {
  id            String            @id @default(uuid())
  integrationId String            @unique @map("integration_id")
  accessToken   String            @map("access_token") @db.Text
  refreshToken  String?           @map("refresh_token") @db.Text
  expiresAt     DateTime?         @map("expires_at")
  status        IntegrationStatus @default(ACTIVE)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_tokens")
}

model Notification {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  title     String
  message   String             @db.Text
  read      Boolean            @default(false)
  createdAt DateTime           @default(now()) @map("created_at")
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Device {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  name     String
  type     String
  lastSeen DateTime @default(now()) @map("last_seen")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model ApiKey {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  key      String    @unique
  lastUsed DateTime? @map("last_used")
  status   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Upload {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  filename         String
  url              String
  size             Int
  mimeType         String              @map("mime_type")
  type             UploadType
  status           UploadStatus        @default(UPLOADING)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment       MessageAttachment[]
  emailAttachments EmailAttachment[]

  @@map("uploads")
}

model Organization {
  id      String @id @default(uuid())
  name    String
  ownerId String @map("owner_id")

  owner   User                 @relation("OrgOwner", fields: [ownerId], references: [id])
  members OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organization_members")
}

model AuditLog {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  action    AuditLogAction
  ip        String?
  userAgent String?        @map("user_agent")
  status    AuditLogStatus @default(SUCCESS)
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Email {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  from        String
  to          String
  cc          String?
  bcc         String?
  subject     String
  html        String            @db.Text
  design      Json
  providerId  String?
  status      EmailStatus       @default(PENDING)
  scheduledAt DateTime?         @map("scheduled_at")
  sentAt      DateTime?         @map("sent_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@map("emails")
}

model EmailAttachment {
  id       String @id @default(uuid())
  emailId  String @map("email_id")
  uploadId String @map("upload_id")
  email    Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("email_attachments")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String   @db.Text
  status      String
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}
