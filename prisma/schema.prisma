// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  name             String
  username         String   @unique
  email            String   @unique
  passwordHash     String   @map("password_hash")
  phone            String?
  avatar           String?
  roleId           String   @map("role_id")
  emailVerified    Boolean  @default(false) @map("email_verified")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  status           String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  role                Role                 @relation(fields: [roleId], references: [id])
  profile             Profile?
  userSettings        UserSettings?
  affiliate           Affiliate?           @relation("AffiliateUser")
  approvedAffiliates  Affiliate[]          @relation("AffiliateApprovedBy")
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  bansReceived        Ban[]                @relation("UserBans")
  bansIssued          Ban[]                @relation("BannedBy")
  warningsReceived    Warning[]            @relation("UserWarnings")
  warningsIssued      Warning[]            @relation("WarnedBy")
  subscriptions       Subscription[]
  payments            Payment[]
  invoices            Invoice[]
  couponRedemptions   CouponRedemption[]
  conversations       Conversation[]
  aiMemory            AiMemory[]
  aiContext           AiContext[]
  tasks               Task[]
  taskLists           TaskList[]
  calendarEvents      CalendarEvent[]
  automations         Automation[]
  integrations        Integration[]
  notifications       Notification[]
  devices             Device[]
  apiKeys             ApiKey[]
  uploads             Upload[]
  ownedOrganizations  Organization[]       @relation("OrgOwner")
  organizationMembers OrganizationMember[]
  auditLogs           AuditLog[]
  emails              Email[]
  supportTickets      SupportTicket[]

  @@map("users")
}

model Profile {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  bio      String?
  language String  @default("en")
  timezone String
  theme    String  @default("light")
  voice    String?
  aiName   String? @map("ai_name")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Affiliate {
  id String @id @default(cuid())

  userId     String  @unique
  couponId   String
  approvedBy String?

  commissionPercentage Decimal @db.Decimal(5, 2)

  freePlan Boolean @default(false)

  status String

  approvedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation("AffiliateUser", fields: [userId], references: [id], onDelete: Cascade)

  coupon         Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  approvedByUser User?  @relation("AffiliateApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@map("affiliates")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  roleId String @map("role_id")
  name   String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  token            String   @unique
  deviceName       String?  @map("device_name")
  deviceType       String?  @map("device_type")
  operatingSystem  String?  @map("operating_system")
  browser          String?
  browserVersion   String?  @map("browser_version")
  ipAddress        String?  @map("ip_address")
  country          String?
  state            String?
  city             String?
  timezone         String?
  userAgent        String?  @map("user_agent")
  isCurrentSession Boolean  @default(false) @map("is_current_session")
  isActive         Boolean  @default(true) @map("is_active")
  isTrusted        Boolean  @default(false) @map("is_trusted")
  loginMethod      String   @map("login_method")
  lastActivity     DateTime @default(now()) @map("last_activity")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Ban {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  reason    String
  type      String
  expiresAt DateTime? @map("expires_at")
  bannedBy  String    @map("banned_by")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user   User @relation("UserBans", fields: [userId], references: [id], onDelete: Cascade)
  banner User @relation("BannedBy", fields: [bannedBy], references: [id])

  @@map("bans")
}

model Warning {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  reason      String
  description String?
  warnedBy    String    @map("warned_by")
  status      String
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  warner User @relation("WarnedBy", fields: [warnedBy], references: [id])

  @@map("warnings")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserSettings {
  id            String  @id @default(uuid())
  userId        String  @unique @map("user_id")
  theme         String  @default("light")
  language      String  @default("en")
  timezone      String
  notifications Boolean @default(true)
  voice         String?
  aiMode        String  @map("ai_mode")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  price         Decimal  @db.Decimal(10, 2)
  dailyRequests Int      @map("daily_requests")
  storageLimit  Int      @map("storage_limit")
  voiceEnabled  Boolean  @default(false) @map("voice_enabled")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]
  coupons       Coupon[]
  accessCodes   AccessCode[]

  @@map("plans")
}

model Subscription {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  planId      String   @map("plan_id")
  status      String
  startedAt   DateTime @default(now()) @map("started_at")
  expiresAt   DateTime @map("expires_at")
  renewalDate DateTime @map("renewal_date")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  subscriptionId String    @map("subscription_id")
  gateway        String
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("USD")
  status         String
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User               @relation(fields: [userId], references: [id])
  subscription Subscription       @relation(fields: [subscriptionId], references: [id])
  invoices     Invoice[]
  redemptions  CouponRedemption[]

  @@map("payments")
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  paymentId String   @map("payment_id")
  amount    Decimal  @db.Decimal(10, 2)
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("invoices")
}

model Coupon {
  id        String    @id @default(uuid())
  code      String    @unique
  type      String
  value     Decimal   @db.Decimal(10, 2)
  maxUses   Int       @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  planId    String?   @map("plan_id")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  plan        Plan?              @relation(fields: [planId], references: [id])
  redemptions CouponRedemption[]
  affiliates  Affiliate[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  userId         String   @map("user_id")
  paymentId      String   @map("payment_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("coupon_redemptions")
}

model AccessCode {
  id        String    @id @default(uuid())
  code      String    @unique
  planId    String    @map("plan_id")
  expiresAt DateTime? @map("expires_at")
  maxUses   Int       @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@map("access_codes")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  model     String
  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @db.Text
  tokens         Int?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  uploadId  String @map("upload_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  upload  Upload  @relation(fields: [uploadId], references: [id])

  @@map("message_attachments")
}

model AiMemory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_memory")
}

model AiContext {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  context   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_context")
}

// ==========================================
// PRODUCTIVITY (TASKS & CALENDAR)
// ==========================================

model Task {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  taskListId  String?   @map("task_list_id")
  title       String
  description String?   @db.Text
  priority    String
  status      String
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskList TaskList?   @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  labels   TaskLabel[]

  @@map("tasks")
}

model TaskList {
  id     String @id @default(uuid())
  userId String @map("user_id")
  name   String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@map("task_lists")
}

model TaskLabel {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  label  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_labels")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?  @db.Text
  start       DateTime
  end         DateTime
  location    String?
  reminder    Boolean  @default(false)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@map("calendar_events")
}

model Reminder {
  id            String  @id @default(uuid())
  eventId       String  @map("event_id")
  minutesBefore Int     @map("minutes_before")
  sent          Boolean @default(false)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Automation {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  name    String
  trigger String
  action  String
  enabled Boolean @default(true)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs AutomationLog[]

  @@map("automations")
}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String   @map("automation_id")
  status       String
  response     String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("automation_logs")
}

model Integration {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  provider String
  status   String

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  token IntegrationToken?

  @@map("integrations")
}

model IntegrationToken {
  id            String    @id @default(uuid())
  integrationId String    @unique @map("integration_id")
  accessToken   String    @map("access_token") @db.Text
  refreshToken  String?   @map("refresh_token") @db.Text
  expiresAt     DateTime? @map("expires_at")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_tokens")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Device {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  name     String
  type     String
  lastSeen DateTime @default(now()) @map("last_seen")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model ApiKey {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  key      String    @unique
  lastUsed DateTime? @map("last_used")
  status   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Upload {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  filename String
  url      String
  size     Int
  mimeType String @map("mime_type")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment MessageAttachment[]

  @@map("uploads")
}

model Organization {
  id      String @id @default(uuid())
  name    String
  ownerId String @map("owner_id")

  owner   User                 @relation("OrgOwner", fields: [ownerId], references: [id])
  members OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  userId         String @map("user_id")
  role           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organization_members")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Email {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  subject  String
  status   String
  provider String
  sentAt   DateTime? @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emails")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String   @db.Text
  status      String
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}
